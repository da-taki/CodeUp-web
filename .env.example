# ==========================
# CODEUP ENVIRONMENT CONFIG
# ==========================

# Flask
FLASK_SECRET_KEY=change-me-in-production

# Primary AI provider.
# Use XAI_API_KEY or GROK_API_KEY for Grok. GROQ_API_KEY remains supported.
XAI_API_KEY=your_xai_or_grok_key_here
GROK_API_KEY=your_xai_or_grok_key_here
GROQ_API_KEY=your_groq_api_key_here
# Master switch — set to 0 to disable cloud AI (variable name kept for backward compat)
GEMINI_ENABLED=1

