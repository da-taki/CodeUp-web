# ==========================
# CODEUP ENVIRONMENT CONFIG
# ==========================

# Flask
FLASK_SECRET_KEY=change-me-in-production

# Environment mode — set to "production" for deployed instances
# CODEUP_ENV=production

# Primary ai provider.
# Use XAI_API_KEY or GROK_API_KEY for Grok. GROQ_API_KEY remains supported
XAI_API_KEY=your_xai_or_grok_key_here
GROK_API_KEY=your_xai_or_grok_key_here
GROQ_API_KEY=your_groq_api_key_here

# Master switch — set to 0 to disable cloud AI
AI_CLOUD_ENABLED=1

# AI concurrency and timeout
# AI_MAX_CONCURRENT=3
# AI_TIMEOUT=30

# Session artifact retention (seconds, default 7 days)
# SESSION_ARTIFACT_MAX_AGE=604800

# Runtime data directory. Defaults to instance/data under the repo.
# DATA_DIR=C:\path\to\codeup-data

# Allowed cross-origins (comma-separated)
# ALLOWED_ORIGINS=https://example.com
